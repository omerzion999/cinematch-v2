{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: FastAPI",
      "type": "process",
      "command": "C:\\Users\\Hello\\AppData\\Local\\Python\\bin\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Vite Dev",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start All",
      "dependsOn": ["Backend: FastAPI", "Frontend: Vite Dev"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}
